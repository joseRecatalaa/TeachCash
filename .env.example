# Copia este fichero a .env.local y rellena los valores. .env.local no se sube a git.

# Supabase → Connect → Connection string → URI → "Transaction pooler" (puerto 6543).
# La usa la aplicación. Sustituye [YOUR-PASSWORD] y codifica @ : / ? # si los tiene.
DATABASE_URL=

# Supabase → Connect → Connection string → URI → "Session pooler" (puerto 5432).
# La usan las migraciones: el Transaction pooler no admite las sentencias que lanzan.
DATABASE_URL_MIGRATIONS=

# Supabase → Project Settings → Data API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…).
# Es pública a propósito: RLS es lo que impide que sirva para leer datos ajenos.
# La Secret key (service_role) NO va aquí ni en ningún otro sitio de la app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare → Turnstile → tu sitio → Site key (modo Invisible).
# La Secret key de Turnstile va en el panel de Supabase, no aquí.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
